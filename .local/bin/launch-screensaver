#!/bin/bash

# Launch the screensaver in the default terminal on the system with the correct font configuration.

# Exit early if we don't have the tte show
if ! command -v tte &>/dev/null; then
  exit 1
fi

# Exit early if screensave is already running
pgrep -f org.yuri.screensaver && exit 0

# Allow screensaver to be turned off but also force started
if [[ -f ~/.local/state/toggles/screensaver-off ]] && [[ $1 != "force" ]]; then
  exit 1
fi

# Silently quit Walker on overlay
walker -q

focused=$(hyprland-monitor-focused)
terminal=$(xdg-terminal-exec --print-id)

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hyprctl dispatch focusmonitor $m

  case $terminal in
  *ghostty*)
    hyprctl dispatch exec -- \
      ghostty --class=org.yuri.screensaver \
      --config-file=~/.config/ghostty/screensaver \
      --font-size=18 \
      -e cmd-screensaver
    ;;
  *kitty*)
    hyprctl dispatch exec -- \
      kitty --class=org.yuri.screensaver \
      --override font_size=18 \
      --override window_padding_width=0 \
      -e cmd-screensaver
    ;;
  *)
    notify-send -u low "Screensaver only runs in Alacritty, Ghostty, or Kitty"
    ;;
  esac
done

hyprctl dispatch focusmonitor $focused
