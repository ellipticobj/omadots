#!/bin/bash

# :summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the  default and rebuild it.
# :requires-sudo=true

sudo cp -r ~/.local/share//default/plymouth/* /usr/share/plymouth/themes//
sudo plymouth-set-default-theme 

if command -v limine-mkinitcpio &>/dev/null; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi
