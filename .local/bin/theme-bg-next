#!/bin/bash
# Cycle to next background
THEMES_DIR="$HOME/.config/themes"
CURRENT="$THEMES_DIR/current"
BG_DIR="$CURRENT/backgrounds"

if [[ ! -d "$BG_DIR" ]]; then
  echo "No backgrounds directory found"
  exit 1
fi

# Get list of backgrounds
mapfile -t bgs < <(ls "$BG_DIR" | grep -E '\.(jpg|jpeg|png|gif|webp)$')

if [[ ${#bgs[@]} -eq 0 ]]; then
  echo "No backgrounds found"
  exit 1
fi

# Get current background
CURRENT_BG=$(readlink -f "$CURRENT/background" 2>/dev/null || echo "")
CURRENT_BG_NAME=$(basename "$CURRENT_BG" 2>/dev/null || echo "")

# Find next
NEXT_IDX=0
for i in "${!bgs[@]}"; do
  if [[ "${bgs[$i]}" == "$CURRENT_BG_NAME" ]]; then
    NEXT_IDX=$(( (i + 1) % ${#bgs[@]} ))
    break
  fi
done

NEXT_BG="${bgs[$NEXT_IDX]}"
theme-bg-set "$BG_DIR/$NEXT_BG"
